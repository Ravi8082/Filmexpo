DATABASE_URL=mysql://root:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:3306/film
NEXT_PUBLIC_SITE_URL=https://filmexpoindia.com
SESSION_SECRET=replace-with-at-least-32-random-characters
# Required only for the first admin setup when running in production.
SUPERADMIN_SETUP_TOKEN=replace-with-a-different-random-token-of-at-least-32-characters
EMAIL_OTP_SECRET=replace-with-a-different-32-character-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Film Expo India <no-reply@example.com>

# Razorpay payment gateway. Leave both blank to keep "Buy Pass" closed (register-only mode).
# Get these from Razorpay Dashboard > Settings > API Keys. Start with rzp_test_ keys.
# The key secret is PRIVATE - only ever put it in .env.local (gitignored), never in the repo or frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Shared secret you also paste into Razorpay Dashboard > Settings > Webhooks when registering
# https://<your-site>/api/razorpay/webhook for events payment.captured, payment.failed, order.paid.
RAZORPAY_WEBHOOK_SECRET=any-random-32+-character-secret
